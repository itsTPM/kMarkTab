{
  "name": "kmarktab",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare && simple-git-hooks",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:real": "WXT_REAL_BOOKMARKS=1 wxt",
    "dev:firefox:real": "WXT_REAL_BOOKMARKS=1 wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && html-validate entrypoints && stylelint \"entrypoints/**/*.css\"",
    "lint:fix": "oxlint --fix && html-validate --fix entrypoints && stylelint --fix \"entrypoints/**/*.css\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "icons": "scripts/generate-icons.sh"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.0",
    "html-validate": "^11.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  }
}
